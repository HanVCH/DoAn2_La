# One Node process serves the existing EJS frontend and the MySQL auth API.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qlthuchi
# Fill with your MySQL/XAMPP account (different from SQL Server sa/SQLEXPRESS).
DB_USER=
DB_PASSWORD=
FRONTEND_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
SESSION_TTL_MINUTES=10080
HOME_PATH=/dashboard
# A stable secret: at least 32 random bytes. Keep in .env; never commit or log it.
OTP_PEPPER=
SMS_ENABLED=false
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
COOKIE_SECURE=false
SMTP_HOST=
OTP_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="LÁ <onboarding@resend.dev>"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
SUPPORT_EMAIL=
# Optional external auth/OAuth adapters. Leave empty for the local MySQL API.
AUTH_REGISTER_URL=
AUTH_LOGIN_URL=
LOGIN_SUCCESS_PATH=
GOOGLE_AUTH_URL=
FACEBOOK_AUTH_URL=
LOGIN_PATH=/login
FORGOT_PASSWORD_PATH=/forgot-password
