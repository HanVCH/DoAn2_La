<!DOCTYPE html>
<html lang="vi">
<head>
  <title>Tạo tài khoản · LÁ</title>
  <%- include('partials/head') %>
  <script src="/js/register.js" type="module"></script>
</head>
<body>
  <div class="page-shell">
    <%- include('partials/header') %>
    <main class="register-layout">
      <%- include('partials/illustration') %>

      <section class="registration" aria-labelledby="register-title">
        <h1 id="register-title">Tạo tài khoản</h1>
        <p class="form-intro">Cùng chăm ví nhỏ, nuôi những dự định lớn.</p>
        <%- include('partials/social-buttons', { isLogin: false }) %>
        <div class="divider"><span>hoặc đăng ký bằng Gmail</span></div>

        <form id="register-form" action="/api/auth/register" method="post" novalidate>
          <div class="field-group">
            <label for="email">Gmail</label>
            <div class="input-wrapper"><svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#mail"/></svg><input id="email" name="email" type="email" placeholder="ban@gmail.com" autocomplete="email" required maxlength="254" aria-describedby="email-error"></div>
            <p class="field-error" id="email-error" hidden></p>
          </div>
          <div class="field-group">
            <label for="phone">Số điện thoại</label>
            <div class="input-wrapper"><svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#phone"/></svg><input id="phone" name="phone" type="tel" placeholder="Nhập số điện thoại" autocomplete="tel" required maxlength="24" aria-describedby="phone-error"></div>
            <p class="field-error" id="phone-error" hidden></p>
          </div>
          <div class="field-group">
            <label for="password">Mật khẩu</label>
            <div class="input-wrapper"><svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#lock"/></svg><input id="password" name="password" type="password" placeholder="Nhập mật khẩu" autocomplete="new-password" required minlength="8" aria-describedby="password-hint password-error"><button class="password-toggle" type="button" data-target="password" aria-label="Hiện mật khẩu" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#eye"/></svg></button></div>
            <p class="field-hint" id="password-hint">Ít nhất 8 ký tự, tối đa 72 byte UTF-8.</p>
            <p class="field-error" id="password-error" hidden></p>
          </div>
          <div class="field-group">
            <label for="passwordConfirmation">Nhập lại mật khẩu</label>
            <div class="input-wrapper"><svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#lock"/></svg><input id="passwordConfirmation" name="passwordConfirmation" type="password" placeholder="Nhập lại mật khẩu" autocomplete="new-password" required aria-describedby="passwordConfirmation-error"><button class="password-toggle" type="button" data-target="passwordConfirmation" aria-label="Hiện mật khẩu nhập lại" aria-pressed="false"><svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#eye"/></svg></button></div>
            <p class="field-error" id="passwordConfirmation-error" hidden></p>
          </div>
          <div class="terms-group">
            <div class="terms-row"><input id="acceptedTerms" name="acceptedTerms" type="checkbox" required aria-describedby="acceptedTerms-error"><label for="acceptedTerms">Tôi đồng ý với <a href="/terms" target="_blank" rel="noopener">Điều khoản sử dụng</a><br class="terms-break"> và <a href="/privacy" target="_blank" rel="noopener">Chính sách bảo mật</a> của LÁ.</label></div>
            <p class="field-error" id="acceptedTerms-error" hidden></p>
          </div>
          <p class="form-status" id="form-status" role="status" aria-live="polite" hidden></p>
          <button class="button primary-button" id="submit-button" type="submit"><span class="loading-spinner" aria-hidden="true" hidden></span><span data-submit-label>Tạo tài khoản</span></button>
          <noscript><p class="field-error">Vui lòng bật JavaScript để kiểm tra thông tin và đăng ký tài khoản.</p></noscript>
        </form>
        <p class="login-prompt">Bạn đã có tài khoản?</p>
        <a class="button login-button" href="<%= loginPath %>"><svg class="icon" aria-hidden="true"><use href="/assets/icons.svg#arrow-left"/></svg>Về trang đăng nhập</a>
        <footer class="page-footer">LÁ · QUẢN LÝ THU CHI CÁ NHÂN</footer>
      </section>
    </main>
  </div>
  <%- include('partials/help-dialog', { isLogin: false }) %>
</body>
</html>
