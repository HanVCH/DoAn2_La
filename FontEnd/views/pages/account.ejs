<div class="app-page-header"><div><p class="page-eyebrow">THÔNG TIN CÁ NHÂN</p><h1>Tài khoản</h1><p class="page-description"><%= page.description %></p></div></div>
<section class="app-card account-profile"><div class="profile-identity"><span class="avatar avatar-large" data-user-initial><%= initial %></span><div><h2 data-user-name><%= displayName %></h2><span class="verified-label"><%- include('../partials/app/icon',{name:'check'}) %>Hồ sơ đã hoàn tất</span></div></div><dl class="profile-details"><div><dt>Họ và tên</dt><dd data-user-name><%= displayName %></dd></div><div><dt>Email</dt><dd><%= state.email %><span class="contact-status"><%= state.email_verified_at ? 'Đã xác thực' : 'Chưa xác thực' %></span></dd></div><div><dt>Số điện thoại</dt><dd><%= state.phone || 'Chưa có thông tin' %><% if (state.phone) { %><span class="contact-status"><%= state.phone_verified_at ? 'Đã xác thực' : 'Chưa xác thực' %></span><% } %></dd></div><div><dt>Quê quán</dt><dd><%= state.hometown || 'Chưa có thông tin' %></dd></div></dl>
  <a class="button" href="<%= navigation.settings %>#settings-profile">Sửa hồ sơ trong Cài đặt</a>
</section>
