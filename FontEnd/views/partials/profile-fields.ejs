<div class="profile-grid">
  <div class="field-group wide"><label for="fullName">Họ và tên</label><div class="input-wrapper"><input id="fullName" name="fullName" autocomplete="name" maxlength="100" required placeholder="Nhập họ và tên của bạn" aria-describedby="fullName-error"></div><p id="fullName-error" class="field-error" hidden></p></div>
  <div class="field-group"><label for="birthDate">Ngày sinh</label><div class="input-wrapper"><input id="birthDate" name="birthDate" type="text" data-date placeholder="dd/mm/yy" autocomplete="bday" required aria-describedby="birthDate-error age-hint"></div><p id="age-hint" class="field-hint">Tuổi được tính từ ngày sinh.</p><p id="birthDate-error" class="field-error" hidden></p></div>
  <div class="field-group"><label for="hometown">Quê quán / tỉnh thành</label><div class="input-wrapper"><input id="hometown" name="hometown" autocomplete="address-level1" maxlength="150" required placeholder="Ví dụ: Thành phố Hồ Chí Minh" aria-describedby="hometown-error"></div><p id="hometown-error" class="field-error" hidden></p></div>
  <div class="field-group wide"><label for="monthlyIncome">Thu nhập hàng tháng (VND)</label><div class="input-wrapper"><input id="monthlyIncome" name="monthlyIncome" inputmode="decimal" required placeholder="Nhập 0 nếu chưa có thu nhập" aria-describedby="income-preview monthlyIncome-error" data-money="decimal"><span class="input-suffix">₫</span></div><p class="field-hint" id="income-preview">Nhập số tiền, tối đa 2 số thập phân.</p><p id="monthlyIncome-error" class="field-error" hidden></p></div>
  <div class="field-group wide"><label for="usagePurpose">Bạn muốn dùng LÁ để làm gì?</label><div class="input-wrapper"><select id="usagePurpose" name="usagePurpose" required aria-describedby="usagePurpose-error"><option value="">Chọn mục đích sử dụng</option><option value="track_expenses">Theo dõi thu chi</option><option value="save_money">Tiết kiệm</option><option value="control_budget">Kiểm soát ngân sách</option><option value="repay_debt">Trả nợ</option><option value="other">Khác</option></select></div><p id="usagePurpose-error" class="field-error" hidden></p></div>
  <div class="field-group wide" id="purpose-note-field" hidden><label for="usagePurposeNote">Mô tả mục đích khác</label><div class="input-wrapper"><input id="usagePurposeNote" name="usagePurposeNote" maxlength="255" placeholder="Chia sẻ điều bạn muốn thực hiện" aria-describedby="usagePurposeNote-error"></div><p id="usagePurposeNote-error" class="field-error" hidden></p></div>
</div>
