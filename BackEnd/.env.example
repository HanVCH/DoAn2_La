# Loaded after ../.env by npm start/dev; shell variables take precedence.
# Keep private keys only in BackEnd/.env (gitignored).
OTP_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM="LÁ <onboarding@resend.dev>"
# Keep existing OTP_PEPPER and FRONTEND_ORIGIN in the root .env.

# Optional AI support widget. Use a server-side OpenAI project API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
